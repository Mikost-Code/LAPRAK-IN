# Salin ke .env dan isi. Semua variabel berawalan LAPRAK_.
LAPRAK_DATA_DIR=data
# SQLite dipakai bila kosong. Produksi: postgresql+psycopg://user:pass@host/laprak
LAPRAK_DATABASE_URL=
# Kosongkan saat dev: kunci dibuat dan disimpan di data/. Produksi: isi keduanya.
LAPRAK_SECRET_KEY=
LAPRAK_MASTER_KEY=
LAPRAK_FRONTEND_ORIGIN=http://localhost:5173
LAPRAK_PUBLIC_URL=http://localhost:8000
LAPRAK_GOOGLE_CLIENT_ID=
LAPRAK_GOOGLE_CLIENT_SECRET=
# 1 = aktifkan POST /api/auth/dev-login tanpa Google (hanya pengembangan lokal)
LAPRAK_DEV_LOGIN=1
LAPRAK_COOKIE_SECURE=0
# Kosong = deteksi otomatis xelatex di PATH / MiKTeX
LAPRAK_TEX_COMPILER=
LAPRAK_TEX_ENGINE=xelatex
